# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Virtual environments ───────────────────────────────
.venv/
.venv312/
venv/
env/

# ── PyInstaller / build output ─────────────────────────
#    (macos_build/ holds the mac build scripts and is intentionally kept)
build/
dist/
dist_macos/

# ── User-specific settings (machine paths, email, exclusions) ──
core/saved_defaults.json
dispatch/saved_settings.json

# ── Runtime-generated sync log ─────────────────────────
back_up_sync/sync_log.txt

# ── Generated test outputs (reports, parsed CSVs, previews) ──
tests/output/

# ── Icon generator scratch/preview renders (the assets themselves are tracked) ──
icons/**/._*

# ── OS / editor cruft ──────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
